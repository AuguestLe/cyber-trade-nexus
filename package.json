{
  "name": "cyber-trade-nexus",
  "private": true,
  "version": "1.0.0",
  "description": "NEXUS — 全球交易态势大屏（赛博 HUD 演示系统）",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node server/index.js",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"server/**/*.js\" \"docs/*.md\"",
    "gen:world": "node scripts/gen-world-outline.mjs"
  },
  "dependencies": {
    "echarts": "5.5.1",
    "express": "4.21.2",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "22.10.2",
    "@types/react": "18.3.17",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "d3-geo": "^3.1.1",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jsdom": "25.0.1",
    "puppeteer-core": "^23.11.1",
    "typescript": "5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
